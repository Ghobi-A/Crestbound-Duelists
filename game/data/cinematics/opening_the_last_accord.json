 "narration": [
  {
   "id": "vo_01",
   "start": 1.5,
   "end": 6.8,
   "text": "There was a time when men believed that power was a blessing."
  },
  {
   "id": "vo_02",
   "start": 7.3,
   "end": 12.6,
   "text": "They built their kingdoms upon it.\nRaised their banners in its name."
  },
  {
   "id": "vo_03",
   "start": 13.2,
   "end": 18.8,
   "text": "And when their neighbours grew stronger, they asked for more."
  },
  {
   "id": "vo_04",
   "start": 25.5,
   "end": 32.5,
   "text": "When the cost became greater than any kingdom could bear,\nthe surviving nations made a promise."
  },
  {
   "id": "vo_05",
   "start": 34.5,
   "end": 41.0,
   "text": "Never again would the power of the Crests\ndetermine the fate of mankind."
  },
  {
   "id": "vo_06",
   "start": 46.5,
   "end": 49.5,
   "text": "Peace endured."
  },
  {
   "id": "vo_07",
   "start": 52.5,
   "end": 57.5,
   "text": "Cities flourished. Generations passed."
  },
  {
   "id": "vo_08",
   "start": 59.5,
   "end": 67.5,
   "text": "And the things we promised to bury\nwere quietly brought back into the light."
  }
 ],
