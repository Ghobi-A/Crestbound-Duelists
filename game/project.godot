; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Crestbound Duelists — Godot 4 pixel-art client.
; Internal canvas: 320x180 (16:9), integer-scaled, nearest-neighbour
; filtering, pixel snapping. See docs/GODOT_SETUP.md.

config_version=5

[application]

config/name="Crestbound Duelists"
config/description="A pixel-art tactical RPG where Duelists bind themselves to Crests and Bonded Entities."
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.3")
config/icon="res://icon.svg"

[autoload]

GameData="*res://scripts/data/game_data.gd"
GameState="*res://scripts/core/game_state.gd"
SaveManager="*res://scripts/save/save_manager.gd"
AudioRouter="*res://scripts/presentation/audio_router.gd"
SceneTransition="*res://scripts/presentation/scene_transition.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[gui]

; Project-wide pixel typeface (tools/generate_font.py). Set here rather
; than per-Label so every Control and every
; draw_string(get_theme_default_font(), ...) picks it up. Note: running
; Godot's importer rewrites this file and strips these comments.
theme/custom_font="res://assets/ui/crestbound_font.fnt"

